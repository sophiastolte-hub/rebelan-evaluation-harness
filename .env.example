# Copy this file to .env and fill in values. Never commit .env.

# API key for the model under evaluation (Anthropic Claude).
ANTHROPIC_API_KEY=

# Model identifier to evaluate, e.g. claude-sonnet-4-5-20250929
EVAL_MODEL=claude-sonnet-4-5-20250929

# Optional: cap spend tracking warnings (USD). The harness logs cumulative
# estimated spend to runs/<run_id>/manifest.json and warns past this value.
BUDGET_WARN_USD=80
BUDGET_HARD_CAP_USD=100
